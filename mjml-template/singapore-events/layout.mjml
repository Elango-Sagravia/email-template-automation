<mjml>
  <mj-head>
    <mj-font
      name="Austin News Text Web"
      href="https://www.singaporesummary.com/fonts/AustinNewsTextWeb.woff2"
    />
  </mj-head>
  <mj-body background-color="#f9f8f9">
    {{%PREVIEW_TEXT%}}

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="15px"></mj-spacer>
      </mj-column>
    </mj-section>

    <!-- header -->
    <mj-section
      background-color="#eff1f4"
      padding="1px 1px 1px 1px"
      border-radius="10px"
    >
      <mj-column background-color="#ffffff" border-radius="10px" padding="0">
        <!-- Top red strip -->
        <mj-text padding="0">
          <div
            style="
              height: 6px;
              border-top-left-radius: 8px;
              border-top-right-radius: 8px;
              background-color: #660000;
            "
          ></div>
        </mj-text>

        <!-- Logo and Date -->
        <mj-section background-color="#ffffff" padding="0px 10px 0px 10px">
          <mj-group width="100%" padding="0px">
            <mj-column width="50%" vertical-align="bottom">
              <mj-spacer height="20px" />
              <mj-image
                align="left"
                width="226px"
                src="https://www.singaporesummary.com/logo-grey.png"
                href="https://www.singaporesummary.com/"
                alt="Singapore Summary newsletter logo"
                padding="0px"
              />
              <mj-image
                width="1px"
                src="https://www.singaporesummary.com/api/emails/open?user_id=%user_id%&campaign_id=%campaign_id%"
                alt=""
              />
            </mj-column>
            <!-- <mj-column width="50%" vertical-align="bottom">
              <mj-text
                align="right"
                font-size="16px"
                font-family="Arial"
                font-weight="300"
                color="#00000096"
                padding="0"
                >Wed, Mar 25 • 27°C
              </mj-text>
            </mj-column> -->
          </mj-group>
        </mj-section>

        <!-- Divider line -->
        <mj-divider
          border-color="#EBEBEB"
          border-width="1px"
          width="100%"
          padding="7px 20px 0 20px"
        />

        <!-- In this edition -->
        <mj-text
          padding="20px 20px 0px 20px"
          font-family="Arial"
          color="#000000"
          font-size="16px"
          font-weight="600"
        >
          In this edition:
        </mj-text>

        <mj-table
          font-family="Arial"
          cellpadding="0"
          cellspacing="0"
          padding="19px 30px 0px 30px"
        >
          {{%IN_THIS_EDITION_ROWS%}}
        </mj-table>

        <!-- Join link -->
        <mj-text
          padding="17px 20px 20px 20px"
          font-family="Arial"
          color="#000000"
          font-size="16px"
          line-height="1.5"
        >
          Was this email forwarded to you?
          <a
            href="https://www.singaporesummary.com/"
            target="_blank"
            style="
              text-decoration: none;
              border-bottom: 2px solid #660000;
              color: black;
            "
          >
            Join Singapore Summary</a
          >.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    {{%SPOTLIGHT_SECTION%}}

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    <!--primary ad -->
    <mj-section
      background-color="#EFF1F4"
      css-class="border-line"
      padding="1px 0.5px 1px 1px"
      border-radius="10px"
    >
      <mj-raw>
        <a href="https://link.singaporesummary.com/REPLACE_ME" target="_blank"
        style="color:black">
      </mj-raw>
      <mj-column background-color="#fff" border-radius="10px" padding="0px">
        <mj-image
          border-radius="10px 10px 0 0"
          padding="0px 0px 10px 0px"
          width="600px"
          src="https://www.singaporesummary.com/email/ad/REPLACE_ME.jpg"
          alt="campaign - gf"
        />
        <mj-text
          padding="2px 12px 8px 12px"
          font-family="TNYAdobeCaslonPro, 'Times New Roman', serif;"
          color="#000000"
        >
          <h2
            style="
              font-size: 24px;
              line-height: 1.2;
              font-weight: 500;
              margin-top: 2px !important;
              margin: 0;
            "
          >
            REPLACE_ME
          </h2>
        </mj-text>
        <mj-spacer height="0px" />

        <mj-text
          padding="10px 12px 0px 12px"
          font-family="Arial"
          color="#000000"
        >
          <p style="font-size: 16px; line-height: 24px; margin: 0 0 10px 0">
            <strong>What’s happening?</strong> REPLACE_ME
          </p>

          <p style="font-size: 16px; line-height: 24px; margin: 0 0 10px 0">
            <strong>For foreign investors:</strong> REPLACE_ME
          </p>
          <p style="font-size: 16px; line-height: 24px; margin: 0">
            <strong>Track record:</strong> REPLACE_ME
          </p>
        </mj-text>
        <mj-text
          padding="10px 12px 8px 12px"
          font-family="Roboto+Serif"
          color="#000000"
        >
          <p style="font-size: 16px; line-height: 24px; margin: 0">
            <a
              style="
                text-decoration: none;
                border-bottom: 2px solid #660000;
                color: black;
              "
              ><strong>REPLACE_ME →</strong></a
            >
          </p>
        </mj-text>
        <mj-spacer height="12px" />
      </mj-column>
      <mj-raw> </a> </mj-raw> </mj-section
    ><!--primary ad -->

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    {{%FEATURED_SECTION%}}

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    {{%LIVE_EVENTS_SECTION%}}

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    {{%SHOPPING_SECTION%}}

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    {{%NIGHTLIFE_SECTION%}}

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    {{%EVERYTHING_ELSE_SECTION%}}

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>

    <mj-section
      background-color="#eff1f4"
      padding="1px 1px 1px 1px"
      border-radius="10px"
    >
      <mj-column background-color="#ffffff" border-radius="10px" padding="0">
        <!-- Top red strip -->
        <mj-text padding="0">
          <div
            style="
              height: 6px;
              border-top-left-radius: 8px;
              border-top-right-radius: 8px;
              background-color: #660000;
            "
          ></div>
        </mj-text>

        <!-- Logo and Date -->
        <mj-spacer height="40px" />
        <mj-image
          align="left"
          width="159px"
          src="https://www.singaporesummary.com/logo-grey.png"
          href="https://www.singaporesummary.com/"
          alt="Singapore Summary newsletter logo"
          padding="0px 20px"
        />
        <mj-text
          padding="18px 20px 0px 20px"
          font-family="Austin News Text Web, TNYAdobeCaslonPro, 'Times New Roman', serif"
          color="#000000"
        >
          <h2
            style="
              font-size: 24px;
              line-height: 1.2;
              font-weight: 400;
              margin: 0;
            "
          >
            The pulse of Singapore.
          </h2>
        </mj-text>
        <mj-text
          padding="10px 20px 0px 20px"
          font-family="Arial"
          font-weight="400"
          color="#000"
        >
          <p style="font-size: 15px; line-height: 1.4; margin: 0 !important">
            This edition was produced by our editorial team and meets the
            <a
              style="
                text-decoration: none;
                border-bottom: 2px solid #660000;
                color: black;
              "
              href="https://www.houseofsummary.com/"
              target="_blank"
              >House of Summary standards</a
            >: accuracy, consistency, high quality, readers first, respect for
            time, and objectivity.
          </p>
        </mj-text>
        <mj-divider
          border-width="1px"
          border-style="solid"
          border-color="#00000080"
          padding="20px 20px 35px 20px"
          width="100%"
        />

        <!-- Footer content -->
        <mj-text
          padding="0px 20px 0px 20px"
          font-family="Arial"
          color="#00000099"
          font-weight="400"
        >
          <p
            style="
              font-size: 10px;
              line-height: normal;
              margin-top: 0 !important;
              margin-bottom: 0px !important;
            "
          >
            <strong>Images credits:</strong> {{%IMAGE_CREDITS%}}
          </p>
        </mj-text>

        <mj-text
          padding="20px 20px 0px 20px"
          font-family="Arial"
          color="#000"
          font-weight="400"
        >
          <p
            style="
              font-size: 12px;
              line-height: normal;
              margin-top: 0;
              margin-bottom: 5px !important;
            "
          >
            Send us your feedback at
            <a
              style="
                text-decoration: none;
                border-bottom: 2px solid #660000;
                color: #000 !important;
              "
              href="mailto:readers@singaporesummary.com"
              target="_blank"
              >readers@singaporesummary.com</a
            >.
          </p>
          <p
            style="
              font-size: 12px;
              line-height: normal;
              margin-top: 0;
              margin-bottom: 5px !important;
            "
          >
            Interested in connecting with curious, informed readers?
            <a
              style="
                text-decoration: none;
                border-bottom: 2px solid #660000;
                color: #000 !important;
              "
              href="https://www.singaporesummary.com/advertise"
              target="_blank"
              >Advertise with us</a
            >.
          </p>
          <p
            style="
              font-size: 12px;
              line-height: normal;
              margin-top: 0;
              margin-bottom: 0 !important;
            "
          >
            <a
              style="
                text-decoration: none;
                border-bottom: 2px solid #660000;
                color: #000 !important;
              "
              href="https://www.singaporesummary.com/unsubscribewithfeedback?unique_id=%unique_id%&campaign_id=%campaign_id%"
              target="_blank"
              >Unsubscribe</a
            >
            from this email.
          </p>
        </mj-text>

        <mj-text
          padding="40px 12px 0px 12px"
          font-family="Arial"
          font-weight="400"
        >
          <p
            class="address-block"
            style="
              text-align: center;
              font-size: 10px;
              color: #000000cc !important;
              line-height: normal;
              margin-top: 0 !important;
              margin-bottom: 5px !important;
            "
          >
            <span style="color: inherit !important">
              30 N Gould St, Ste N, Sheridan, WY 82801, United States
            </span>
          </p>
          <p
            style="
              text-align: center;
              font-size: 10px;
              color: #000000cc;
              line-height: normal;
              margin-top: 0 !important;
              margin-bottom: 0 !important;
            "
          >
            Copyright © 2026 House of Summary LLC, All rights reserved.
          </p>
        </mj-text>

        <mj-spacer height="32px" />
      </mj-column>
    </mj-section>

    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="15px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
