<mjml>
  <mj-head>
    <mj-font
      name="Austin News Text Web"
      href="https://www.londonsummary.com/fonts/AustinNewsTextWeb.woff2"
    />
  </mj-head>
  <mj-body background-color="#f9f8f9">
    <mj-raw>
  <div style="display: none; max-height: 0px; overflow: hidden">Plus things to do this weekend</div>
  <div style="display: none; max-height: 0px; overflow: hidden">
