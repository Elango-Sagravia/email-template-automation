  <h2 style="font-size: 24px; line-height: 1.2; font-weight: 400; margin: 0;">
    Senior Finance Manager - Construction Real Estate
  </h2>
</mj-text>

<!-- Tags -->
<mj-text padding="20px 12px" font-family="Arial, regular">
