<mjml>
  <mj-head>
    <mj-style>
      h2,
      img,
      p {
        margin: 0;
      }
      p {
        margin-bottom: 10px;
      }
    </mj-style>
    <mj-font
      name="Austin News Text Web"
      href="https://www.dubaisummary.com/fonts/AustinNewsTextWeb.woff2"
    />
  </mj-head>

  <mj-body background-color="#f9f8f9">
    <mj-raw>
  <div style="display: none; max-height: 0px; overflow: hidden">Plus things to do this weekend</div>
  <div style="display: none; max-height: 0px; overflow: hidden">
    &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy;
    &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy;
  </div>
</mj-raw>

    <!-- header -->
    <mj-spacer height="15px"></mj-spacer>
    <mj-section padding="0px" css-class="blue-header">
      <mj-column>
        <mj-text padding="0px">
          <div
            style="
              border-top-left-radius: 3px;
              border-top-right-radius: 3px;
              height: 7px;
              background-color: #eeca66;
            "
          ></div>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#102341" padding="30px 0">
      <mj-column width="50%" vertical-align="middle">
        <mj-raw>
          <table align="center" role="presentation" border="0" cellpadding="0"
          cellspacing="0"> <tr> <td align="center" style="padding: 0 10px 0
          10px"> <img src="https://www.dubaisummary.com/email/images/ds-r-1.png"
          width="50px" style="border-radius: 50%; display: block" /> </td> <td
          align="center" style="padding: 0 10px 0 0"> <img
          src="https://www.dubaisummary.com/email/images/ds-r-2.png"
          width="50px" style="border-radius: 50%; display: block" /> </td> <td
          align="center" style="padding: 0 10px 0 0"> <img
          src="https://www.dubaisummary.com/email/images/ds-r-3.png"
          width="50px" style="border-radius: 50%; display: block" /> </td> </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>
    <mj-section background-color="#102341" padding="0px 12px 12px 12px">
      <mj-column>
        <mj-image
          align="left"
          padding="0"
          css-class="light_img"
          width="302px"
          src="https://www.dubaisummary.com/email/images/ds-email-new-logo.png"
          href="https://www.dubaisummary.com"
          alt=""
        />
        <mj-image
          width="1px"
          src="https://www.dubaisummary.com/api/emails/open?user_id=%user_id%&campaign_id=%campaign_id%"
          alt=""
        />
        <!-- <mj-text
          margin-top="0"
          font-size="16px"
          font-family="Arial"
          font-weight="300"
          color="#FFFFFF96"
          padding="2px 0 0 0"
        >
          Tuesday • Mar 31 • 28°C
        </mj-text> -->
      </mj-column>
    </mj-section>

    <!-- in this edition -->
    <mj-section
      background-color="#eff1f4"
      padding="1px 1px 1px 1px"
      border-radius="5px"
    >
      <mj-column
        background-color="#fff"
        border-radius="0px 0px 5px 5px"
        padding="0px"
      >
        <mj-spacer height="10px" />
        <mj-text
          padding="10px 12px 0px 12px"
          font-family="Arial"
          color="#000000"
        >
          <p style="font-size: 16px; line-height: 1.5">
            <strong>In this edition:</strong>
          </p>
        </mj-text>
        <mj-table
          font-family="Arial"
          cellpadding="0"
          cellspacing="0"
          padding="0px 18px 0px 18px"
          style="width: 100%"
        >
          <tr>
  <td
    style="
      font-size: 18px;
      width: 20px;
      vertical-align: top;
      padding-right: 8px;
      line-height: 1.6;
    "
  >
    →
  </td>
  <td style="font-size: 16px; line-height: 1.6">
    Kadura Rally returns
  </td>
</tr>
<tr>
  <td
    style="
      font-size: 18px;
      width: 20px;
      vertical-align: top;
      padding-right: 8px;
      line-height: 1.6;
    "
  >
    →
  </td>
  <td style="font-size: 16px; line-height: 1.6">
    Metal Fest III
  </td>
</tr>
<tr>
  <td
    style="
      font-size: 18px;
      width: 20px;
      vertical-align: top;
      padding-right: 8px;
      line-height: 1.6;
    "
  >
    →
  </td>
  <td style="font-size: 16px; line-height: 1.6">
    Fideles at Be Beach Dubai
  </td>
</tr>
        </mj-table>
        <mj-text
          padding="10px 12px 18px 12px"
          font-family="Arial"
          color="#000000"
        >
          <p style="font-size: 16px; line-height: 1.5; margin-bottom: 0px">
            Was this email forwarded to you?
            <a
              style="
                text-decoration: none;
                border-bottom: 2px solid #102341;
                color: black;
              "
              href="https://link.dubaisummary.com/join-dubai-summary"
              target="_blank"
              >Join Dubai Summary</a
            >.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-spacer height="10px" />
    <mj-section
  background-color="#eff1f4"
  padding="1px 0.5px 1px 1px"
  border-radius="5px"
>
  <mj-column background-color="#fff" border-radius="5px" padding="0px">
    <mj-table
  css-class="new-heading-with-border"
  cellpadding="0"
  cellspacing="0"
  width="100%"
  padding="16px 0px 12px 0px"
>
  <tr>
    <td
      valign="middle"
      style="
        width: 12%;
        font-size: 0;
        line-height: 0;
        padding: 0px;
        mso-line-height-rule: exactly;
      "
    >
      <div style="height: 0px; border-top: 4px solid #eeca66">&nbsp;</div>
    </td>
    <td
      valign="middle"
      style="padding: 0 8px; text-align: center; white-space: nowrap"
    >
      <span
        style="
          display: inline-block;
          font-weight: 900;
          font-size: 15px;
          line-height: 1.2;
          font-family: Arial, sans-serif;
          color: #000000;
          text-transform: uppercase;
        "
      >
        Spotlight
      </span>
    </td>
    <td
      valign="middle"
      style="
        width: 100%;
        font-size: 0;
        line-height: 0;
        padding: 0px;
        mso-line-height-rule: exactly;
      "
    >
      <div style="height: 0px; border-top: 4px solid #eeca66">&nbsp;</div>
    </td>
  </tr>
</mj-table>
    <mj-text
      padding="10px 12px"
      font-family="Austin News Text Web, TNYAdobeCaslonPro, 'Times New Roman', serif"
      color="#000000"
    >
      <h2
        style="
          font-size: 24px;
          line-height: 1.2;
          font-weight: 400;
          margin: 0;
        "
      >
        Standup stars unite
      </h2>
    </mj-text>

    <mj-image
      border-radius="10px"
      padding="10px 12px"
      width="600px"
      src="https://www.dubaisummary.com/email/images/REPLACE_ME.jpg"
      alt="REPLACE_ME"
      href="https://www.dubaisummary.com/"
      target="_blank"
    />

    <mj-text
      padding="10px 12px 16px 12px"
      font-family="Arial"
      color="#000000"
    >
      <p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">The Laughter Factory is back with a high-energy lineup, bringing together a mix of international stars and regional favourites for a night of sharp, unapologetic comedy. Headlining the show is Netflix star Robbie Collins, joined by British comic John Hague, Dubai-based performer Valentina Danubio, and poet-storyteller Viswajit Dilip.</p>
<p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">Known for its lively atmosphere and consistently strong lineups, The Laughter Factory promises an evening packed with quick wit, engaging storytelling, and moments that will keep audiences laughing long after the show ends.</p>
      <p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">🔗 <strong>Link:</strong> <a style="text-decoration: none; border-bottom: 2px solid #102341; color: black;" href="https://thelaughterfactory.com/upcoming-events/" target="_blank">The Laughter Factory</a><br />📅 <strong>When:</strong> April 11 and April 12<br />💸 <strong>Cost:</strong> Starts from AED 175<br />📍 <strong>Where:</strong> Multiple venues</p>
    </mj-text>
  </mj-column>
</mj-section>

    <mj-spacer height="10px" />
    <!-- keep your ad block exactly here -->

    <mj-spacer height="10px" />
    <mj-section
  background-color="#eff1f4"
  padding="1px 0.5px 1px 1px"
  border-radius="5px"
>
  <mj-column background-color="#fff" border-radius="5px" padding="0px">
    <mj-spacer height="10px" />
    <mj-text
      padding="16px 12px 0px 12px"
      font-family="Austin News Text Web, TNYAdobeCaslonPro, 'Times New Roman', serif"
      color="#000000"
    >
      <h2
        style="
          font-size: 24px;
          line-height: 1.2;
          font-weight: 400;
          margin: 0;
        "
      >
        Kandura Rally returns
      </h2>
    </mj-text>

    <mj-image
      border-radius="10px"
      padding="10px 12px"
      width="600px"
      src="https://www.dubaisummary.com/email/images/REPLACE_ME.jpg"
      alt="REPLACE_ME"
      href="https://www.dubaisummary.com/"
      target="_blank"
    />

    <mj-text
      padding="10px 12px 16px 12px"
      font-family="Arial"
      color="#000000"
    >
      <p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">The fifth edition of the Kandura Rally returns to Dubai Festival City, promising a vibrant celebration of automotive culture. Drawing over 500 cars and bikes, the event brings together enthusiasts, collectors, and industry players for a dynamic motor show and competition.</p>
<p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">Attendees can explore a diverse showcase of cutting-edge models, vintage classics, luxury vehicles, modified sports cars, electric vehicles, off-road machines, and high-performance superbikes.</p>
      <p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">🔗 <strong>Link:</strong> <a style="text-decoration: none; border-bottom: 2px solid #102341; color: black;" href="https://kandurarally.com/" target="_blank">Kandura Rally</a><br />📅 <strong>When:</strong> April 11, 11 am<br />💸 <strong>Cost:</strong> Starts from AED 25<br />📍 <strong>Where:</strong> Dubai Festival City Mall</p>
    </mj-text>
  </mj-column>
</mj-section>

    <mj-spacer height="10px" />
    <mj-section
  background-color="#eff1f4"
