    <mj-table
  padding="15px 12px 0px 12px"
  width="100%"
  cellpadding="0"
  cellspacing="0"
>
  <tr>
    <td width="30%" valign="top" style="padding: 0">
      <a href="https://www.dubaisummary.com/" target="_blank">
        <img
          src="https://www.dubaisummary.com/email/images/REPLACE_ME.jpg"
          alt="REPLACE_ME"
          width="170"
          style="
            display: block;
            width: 100%;
            max-width: 170px;
            border-radius: 8px;
          "
        />
      </a>
    </td>
    <td
      width="70%"
      valign="top"
      style="
        padding: 0 0 0 15px;
        font-family: Arial, sans-serif;
        color: #000;
      "
    >
      <p
        style="
          margin-bottom: 7px;
          margin-top: 6px;
          line-height: 16px;
          font-size: 16px;
        "
      >
        <strong>Metal Fest III</strong>
      </p>
      <p style="margin: 0 0 10px 0; line-height: 24px; font-size: 16px">Dubai&#39;s metal community returns for the strongest edition of Metal Fest yet. The event features Verdict, Triton, April, and Stowaways, blending progressive intensity, rising momentum, and a decade of raw, high-energy live performances.</p>
      <p style="margin: 0; line-height: 24px; font-size: 16px">
              📅 <strong>When:</strong> <a
          style="
            text-decoration: none;
            border-bottom: 2px solid #102341;
            color: black;
          "
          href="https://dubai.platinumlist.net/event-tickets/105322/the-fridge-presents-metal-fest-iii-in-dubai"
          target="_blank"
        >6:00 pm on April 11, Saturday | Tickets start from 24.09 USD</a>
            </p>
      
    </td>
  </tr>
</mj-table>
