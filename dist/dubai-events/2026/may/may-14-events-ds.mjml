        <mj-text
          padding="10px 12px 16px 12px"
          font-family="Arial"
          color="#000000"
        >
          <p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">
            REPLACE_ME
          </p>
          <p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">
            REPLACE_ME
          </p>
          <p style="font-size: 16px; line-height: 1.5; margin: 0 0 10px 0">
            🔗 <strong>Link:</strong>
            <a
              style="
                text-decoration: none;
                border-bottom: 2px solid #102341;
                color: black;
              "
              href="REPLACE_ME"
              target="_blank"
              >REPLACE_ME</a
            ><br />
            📅 <strong>When:</strong>REPLACE_ME <br />
            💸 <strong>Cost:</strong> REPLACE_ME<br />
            📍 <strong>Where:</strong>
            <a
              style="
                text-decoration: none;
