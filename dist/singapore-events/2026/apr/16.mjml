    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="15px"></mj-spacer>
      </mj-column>
    </mj-section>

    <!-- header -->
    <mj-section
      background-color="#eff1f4"
      padding="1px 1px 1px 1px"
      border-radius="10px"
    >
      <mj-column background-color="#ffffff" border-radius="10px" padding="0">
        <!-- Top red strip -->
        <mj-text padding="0">
          <div
            style="
              height: 6px;
              border-top-left-radius: 8px;
              border-top-right-radius: 8px;
              background-color: #660000;
            "
          ></div>
        </mj-text>

        <!-- Logo and Date -->
        <mj-section background-color="#ffffff" padding="0px 10px 0px 10px">
          <mj-group width="100%" padding="0px">
            <mj-column width="50%" vertical-align="bottom">
              <mj-spacer height="20px" />
              <mj-image
                align="left"
                width="226px"
                src="https://www.singaporesummary.com/logo-grey.png"
                href="https://www.singaporesummary.com/"
                alt="Singapore Summary newsletter logo"
                padding="0px"
              />
              <mj-image
                width="1px"
                src="https://www.singaporesummary.com/api/emails/open?user_id=%user_id%&campaign_id=%campaign_id%"
                alt=""
              />
            </mj-column>
            <!-- <mj-column width="50%" vertical-align="bottom">
              <mj-text
                align="right"
                font-size="16px"
                font-family="Arial"
                font-weight="300"
                color="#00000096"
                padding="0"
                >Wed, Mar 25 • 27°C
              </mj-text>
            </mj-column> -->
          </mj-group>
        </mj-section>

        <!-- Divider line -->
        <mj-divider
          border-color="#EBEBEB"
          border-width="1px"
          width="100%"
          padding="7px 20px 0 20px"
        />

        <!-- In this edition -->
        <mj-text
          padding="20px 20px 0px 20px"
          font-family="Arial"
          color="#000000"
          font-size="16px"
          font-weight="600"
        >
          In this edition:
        </mj-text>

        <mj-table
          font-family="Arial"
          cellpadding="0"
          cellspacing="0"
          padding="19px 30px 0px 30px"
        >
          <tr>
  <td
    style="
      font-size: 18px;
      width: 20px;
      vertical-align: top;
      padding-right: 8px;
      padding-bottom: 5px;
    "
  >
    →
  </td>
  <td
    style="
      font-size: 16px;
      line-height: 24px; padding-bottom: 11px;
    "
  >
    From Vines to Wine
  </td>
</tr>
<tr>
  <td
    style="
      font-size: 18px;
      width: 20px;
      vertical-align: top;
      padding-right: 8px;
      padding-bottom: 5px;
    "
  >
    →
  </td>
  <td
    style="
      font-size: 16px;
      line-height: 24px; padding-bottom: 11px;
    "
  >
    Preloved Fashion Pop-Up
  </td>
</tr>
<tr>
  <td
    style="
      font-size: 18px;
      width: 20px;
      vertical-align: top;
      padding-right: 8px;
      
    "
  >
    →
  </td>
  <td
    style="
      font-size: 16px;
      line-height: 1.6;
    "
  >
    ZUTOMAYO INTENSE II
  </td>
</tr>
        </mj-table>

        <!-- Join link -->
        <mj-text
